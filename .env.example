# Copy to .env and adjust as needed. All values have defaults in config.py.

# Embedding / vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
VECTOR_DB_PATH=./chroma_db
COLLECTION_NAME=mf_faq

# Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Retrieval
TOP_K=5
SCORE_THRESHOLD=0.30

# Generation — Groq (OpenAI-compatible REST API)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
# Paste your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# HTTP (ingestion loader)
REQUEST_TIMEOUT=30
REQUEST_RETRIES=3
RETRY_BACKOFF_SECONDS=2
